{
  "name": "do-not-tamper-sticker-tool",
  "version": "1.0.0",
  "description": "Web-based custom sticker tool based on the Do Not Tamper game sticker template.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf:dev": "npm run build && wrangler dev",
    "lint": "npm run lint:types && npm run lint:css && npm run lint:unused",
    "lint:types": "tsc --noEmit",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:unused": "bash scripts/check-unused-css.sh",
    "prepare": "husky"
  },
  "license": "MIT",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "stylelint": "^17.9.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.11.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wrangler": "^4.84.0"
  },
  "lint-staged": {
    "src/**/*.css": "stylelint",
    "src/**/*.ts": "bash -c 'tsc --noEmit'"
  },
  "dependencies": {
    "jspdf": "^4.2.1"
  }
}
